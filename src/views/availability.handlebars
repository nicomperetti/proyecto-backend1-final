<section>
  <div class="section-heading">
    <div>
      <h2>Disponibilidad y reservas</h2>
      <p>Datos reales consultados desde MongoDB a través de Service, Repository y DAO.</p>
    </div>
  </div>

  {{#if error}}
    <div class="alert">{{error}}</div>
  {{/if}}

  <div class="availability-grid">
    <div>
      <h3>Disponibilidad de servicios</h3>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Servicio</th><th>Categoría</th><th>Duración</th><th>Estado</th></tr></thead>
          <tbody>
            {{#each services}}
              <tr>
                <td>{{name}}</td>
                <td>{{category}}</td>
                <td>{{duration}} min</td>
                <td>{{#if available}}Disponible{{else}}No disponible{{/if}}</td>
              </tr>
            {{else}}
              <tr><td colspan="4">No hay servicios registrados.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <h3>Reservas registradas</h3>
      <div class="booking-list">
        {{#each bookings}}
          <article class="booking">
            <strong>{{clientName}}</strong>
            <span>{{date}} — {{time}}</span>
            <span>Estado: {{status}}</span>
            <span>Servicios: {{services.length}}</span>
          </article>
        {{else}}
          <p>No hay reservas registradas.</p>
        {{/each}}
      </div>
    </div>
  </div>
</section>
